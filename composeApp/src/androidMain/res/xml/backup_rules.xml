<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 et en deçà (minSdk 26). `allowBackup="false"` suffit à ces
    versions ; ces exclusions sont une ceinture par-dessus les bretelles, pour
    qu'aucune remise à `true` distraite ne rouvre la porte en silence.

    Voir res/xml/data_extraction_rules.xml pour Android 12+, et le commentaire
    du manifeste pour la raison : les cinq données d'incarnation sont la clé.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
