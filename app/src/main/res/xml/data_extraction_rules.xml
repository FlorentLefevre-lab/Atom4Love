<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 et au-delà. Rien de cette station ne sort de l'appareil.

    `allowBackup="false"` suffit à couper la sauvegarde cloud, mais PAS le
    transfert d'appareil à appareil : celui-ci ne se contrôle que d'ici. Les deux
    sont donc fermés explicitement, domaine par domaine.

    Ce qu'on refuse de laisser partir : les cinq données d'incarnation, en clair
    dans le DataStore — elles sont la clé LOVE elle-même — et le coffre du
    MULTIPASS, illisible ailleurs mais qui n'a aucune raison de voyager.

    Rien n'est perdu : le noyau se redérive des cinq données, et le compte se
    récupère auprès de sa station avec le code PASS.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
