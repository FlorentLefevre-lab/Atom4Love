<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Autocomplétion des communes (API Adresse data.gouv.fr), géocodage du
         lieu de naissance, et bientôt les relais NOSTR. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Découverte du relais NOSTR local : suivre le réseau Wi-Fi pour sonder
         sa passerelle (nostr/LocalRelayScout). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- POC diag/WifiConcurrencyProbe : AP local + scan simultanés — à retirer
         avec le package diag maintenant que la question BLE/Wi-Fi est tranchée. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Rejoindre un groupe Wi-Fi Direct par requête réseau (WifiNetworkSpecifier) :
         c'est ConnectivityManager qui porte la connexion, pas WifiP2pManager. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- Exigée par le scan Wi-Fi du POC, et par proximity/CellLocator pour calculer
         la cellule H3 — sur l'appareil uniquement : la position ne sort jamais du
         device, seule l'adresse 4D (D2) est diffusée (« pas de traçage de position »). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <!-- POC diag/BleConcurrencyProbe : annonce BLE « phix2 » + scan simultanés.
         Permissions runtime à partir d'API 31, d'installation avant. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <!-- Connexions GATT (POC causerie BLE diag/BleChatProbe, puis handshake Noise). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <!-- Module proximité : balise BLE continue portée par un service foreground.
         Le type location permet à CellLocator de résoudre la cellule H3 même
         app en arrière-plan (le type n'est déclaré au startForeground que si la
         permission de localisation est accordée). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- usesCleartextTraffic : le relais NOSTR local d'une station Astroport est
         servi en ws:// sur la passerelle du hot-spot (IP dynamique, donc pas de
         domain-config possible). Les relais publics restent en wss:// (TLS). -->
    <!-- allowBackup="false" : rien de cette station ne doit remonter chez qui que
         ce soit. Les cinq données d'incarnation vivent en clair dans le DataStore
         — elles SONT la clé LOVE, qui les a la redérive. Les sauvegarder, c'est
         confier la clé à un serveur central, exactement ce que le projet refuse ;
         et la restauration automatique recopie l'incarnation d'un appareil sur
         l'autre (observé le 2026-08-12 : une tablette est repartie avec le noyau
         d'un autre appareil du même compte). Rien n'est perdu pour autant : le
         noyau se redérive des cinq données, et le compte se récupère auprès de sa
         station avec le code PASS. -->
    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Atom4Love">
        <!--
            La station se tient debout, et elle ne se recrée pas.

            `screenOrientation` la verrouille en portrait : un quart de tour
            involontaire rejouait tout l'écran, ce qui n'apporte rien ici — la
            cabine, le radar et le noyau sont des colonnes.

            `configChanges` est la ceinture de la bretelle, et fait le vrai
            travail : l'activité n'est plus détruite pour un changement de
            configuration. Ça vaut aussi là où le verrou ne s'applique pas —
            Android ignore l'orientation demandée sur les grands écrans — et
            pour un redimensionnement en fenêtres partagées, que le verrou ne
            couvre pas du tout. Compose recompose avec la nouvelle
            configuration : rien n'est perdu, rien ne redémarre.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.Atom4Love"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Balise de proximité : annonce l'adresse 4D et scanne les pairs en continu.
             Démarrée/coupée depuis l'écran Radar (ProximityService.start/stop). -->
        <service
            android:name=".proximity.ProximityService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|location" />

        <!-- Les écrans de diagnostic (diag/) sont déclarés dans le manifeste
             debug seulement : ils s'exposent en android:exported pour être
             lancés par adb, et la causerie BLE échange EN CLAIR dans les airs.
             Exportés en release, ils offriraient à n'importe quelle appli
             installée un point d'entrée sans permission vers cet échange. -->

        <!-- Ouvre les pièces jointes reçues (files/chat/) dans la visionneuse
             système sans exposer le stockage interne. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>