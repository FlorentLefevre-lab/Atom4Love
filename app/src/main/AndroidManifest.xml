<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Autocomplétion des communes (API Adresse data.gouv.fr), géocodage du
         lieu de naissance, et bientôt les relais NOSTR. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- POC diag/WifiConcurrencyProbe : AP local + scan simultanés — à retirer
         avec le package diag maintenant que la question BLE/Wi-Fi est tranchée. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Exigée par le scan Wi-Fi du POC, et par proximity/CellLocator pour calculer
         la cellule H3 — sur l'appareil uniquement : la position ne sort jamais du
         device, seule l'adresse 4D (D2) est diffusée (« pas de traçage de position »). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <!-- POC diag/BleConcurrencyProbe : annonce BLE « phix2 » + scan simultanés.
         Permissions runtime à partir d'API 31, d'installation avant. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <!-- Module proximité : balise BLE continue portée par un service foreground.
         Le type location permet à CellLocator de résoudre la cellule H3 même
         app en arrière-plan (le type n'est déclaré au startForeground que si la
         permission de localisation est accordée). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Atom4Love">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Atom4Love"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- POC : écran de diagnostic AP+scan, hors navigation de l'app.
             Lancement : adb shell am start -n <applicationId>/one.astroport.atom4love.diag.WifiProbeActivity -->
        <!-- Balise de proximité : annonce l'adresse 4D et scanne les pairs en continu.
             Démarrée/coupée depuis l'écran Radar (ProximityService.start/stop). -->
        <service
            android:name=".proximity.ProximityService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|location" />

        <activity
            android:name=".diag.WifiProbeActivity"
            android:exported="true"
            android:label="Sonde Wi-Fi (POC)"
            android:theme="@style/Theme.Atom4Love" />
    </application>

</manifest>