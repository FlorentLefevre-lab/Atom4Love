# --- Gradle ---
.gradle/
build/
/build
/captures
.externalNativeBuild
.cxx
.kotlin/

# --- IDE ---
*.iml
/.idea/
!/.idea/codeStyles/
!/.idea/inspectionProfiles/
.DS_Store

# --- Local (spécifique machine) ---
local.properties

# --- SECRETS : ne jamais versionner ---
keystore.properties
*.keystore
*.jks
google-services.json
/secrets.properties

# --- Artefacts de build ---
*.apk
*.aab
*.aar
# Exception : dépendances embarquées volontairement (AAR h3 patché libm)
!composeApp/libs/*.aar
*.ap_
*.dex
/release/
/debug/

# --- Logs ---
*.log

# Enregistrements OBS
*.mkv
*.mp4

# Outils Python de tools/
__pycache__/
*.pyc

# --- Charge utile de www/ : assemblée pour publier, jamais versionnée ---
# `www/index.html` est le seul fichier suivi du dossier. À côté de lui viennent
# deux COPIES, faites au moment de publier et remplacées à chaque version :
# l'APK (déjà couvert par `*.apk` plus haut) et le manifeste, qui n'est que
# `latest.json` de la racine sous le nom qu'attend la page. Les versionner
# donnerait deux sources pour la même vérité, et 6,5 Mo de binaire par version
# dans l'historique ; l'hôte de l'APK est la release GitHub.
/www/atom4love.json
