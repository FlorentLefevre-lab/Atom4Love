# --- Gradle ---
.gradle/
build/
/build
/captures
.externalNativeBuild
.cxx
.kotlin/

# --- IDE ---
*.iml
/.idea/
!/.idea/codeStyles/
!/.idea/inspectionProfiles/
.DS_Store

# --- Local (spécifique machine) ---
local.properties

# --- SECRETS : ne jamais versionner ---
keystore.properties
*.keystore
*.jks
google-services.json
/secrets.properties

# --- Artefacts de build ---
*.apk
*.aab
*.aar
# Exception : dépendances embarquées volontairement (AAR h3 patché libm)
!composeApp/libs/*.aar
*.ap_
*.dex
/release/
/debug/

# --- Logs ---
*.log

# Enregistrements OBS
*.mkv
*.mp4

# Outils Python de tools/
__pycache__/
*.pyc

# --- www/ EST publié depuis ce dépôt : tout y est suivi ---
# Le miroir de Fred n'est pas alimenté par nous — il vient chercher. Le dossier
# doit donc être complet et servable tel quel depuis le dépôt : la page, le
# manifeste sous le nom qu'elle appelle, et l'APK. L'exception ci-dessous est
# nécessaire, sinon la règle `*.apk` plus haut avalerait l'APK sans un mot.
# ⚠ Les trois se remplacent ENSEMBLE à chaque version — une page servie sous
# une adresse constante avec l'empreinte d'hier fait passer le bon fichier pour
# un fichier corrompu (cf. tools/release.sh et docs/note-distribution-apk.md).
!/www/atom4love-latest.apk
